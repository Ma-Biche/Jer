<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET Framework 4.8 is part of Windows 10 (1903 and later) and Windows 11, so Jer.exe needs no
      runtime of its own: the whole app is a single small exe. The C# compiler is still the latest one.
    -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux/macOS too (it still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- One exe for every PC: runs as 64-bit on x64 and natively on ARM64 (Windows 11). -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <AssemblyName>Jer</AssemblyName>
    <RootNamespace>Jer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Jer.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Product>Jer</Product>
    <Title>Jer</Title>
    <Description>A living notch for Windows</Description>
    <Authors>Ma-Biche</Authors>
    <Copyright>Copyright (c) 2026 Ma-Biche. MIT License.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <!-- Windows APIs (media sessions, power, network). Compile-time only: nothing is copied next to Jer.exe. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Jer.ico" />
    <Resource Include="Assets\Jer.png" />
    <Resource Include="Assets\TrayWhite.ico" />
    <Resource Include="Assets\TrayBlack.ico" />
  </ItemGroup>

</Project>
