<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809: the first build with the system media session API. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux/macOS too (it still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Jer</AssemblyName>
    <RootNamespace>Jer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Jer.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Jer</Product>
    <Title>Jer</Title>
    <Description>A living notch for Windows</Description>
    <Authors>Ma-Biche</Authors>
    <Copyright>Copyright (c) 2026 Ma-Biche. MIT License.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF reads DPI awareness from app.manifest; the WinForms hint does not apply here. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Jer.ico" />
    <Resource Include="Assets\Jer.png" />
    <Resource Include="Assets\TrayWhite.ico" />
    <Resource Include="Assets\TrayBlack.ico" />
  </ItemGroup>

</Project>
