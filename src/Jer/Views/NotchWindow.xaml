<Window x:Class="Jer.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jer" Width="860" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Jer.Font}" Foreground="White" FontSize="13">

    <Window.Resources>
        <!-- Play / pause icon switches with the playback state. -->
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource Jer.IconButton}">
            <Setter Property="Tag" Value="{StaticResource Icon.Play}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Music.Media.IsPlaying}" Value="True">
                    <Setter Property="Tag" Value="{StaticResource Icon.Pause}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LyricsToggleButton" TargetType="Button" BasedOn="{StaticResource Jer.IconButton}">
            <Setter Property="Tag" Value="{StaticResource Icon.Lyrics}"/>
            <Setter Property="Foreground" Value="{StaticResource Jer.Text2}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Music.LyricsEnabled}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Jer.Accent}"/>
                    <Setter Property="Background" Value="{StaticResource Jer.Fill1}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpeakerButton" TargetType="Button" BasedOn="{StaticResource Jer.IconButton}">
            <Setter Property="Tag" Value="{StaticResource Icon.Speaker}"/>
            <Setter Property="Foreground" Value="{StaticResource Jer.Text2}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Music.IsMuted}" Value="True">
                    <Setter Property="Tag" Value="{StaticResource Icon.SpeakerMute}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Collapsed clock: shows the Pomodoro countdown while a session runs. -->
        <Style x:Key="CollapsedClock" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding TimeText}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pomodoro.IsRunning}" Value="True">
                    <Setter Property="Text" Value="{Binding Pomodoro.RemainingText}"/>
                    <Setter Property="Foreground" Value="{Binding Pomodoro.ModeBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PageHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Width="860" Height="260" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- The notch, with two small curves that blend it into the top edge of the screen. -->
            <Grid x:Name="NotchHost" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="LeftShoulder" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top"
                      Fill="Black" Data="M0,0 H10 V10 A10,10 0 0 0 0,0 Z"/>

                <Border x:Name="NotchBody" Grid.Column="1" Width="196" Height="32" Background="Black"
                        VerticalAlignment="Top" AllowDrop="True">
                    <Grid>

                        <!-- ============ Closed ============ -->
                        <Grid x:Name="CollapsedView" Height="32" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="MiniArt" Grid.Column="0" Width="20" Height="20" CornerRadius="6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Jer.Fill2}">
                                <Grid>
                                    <Path Data="{StaticResource Icon.Music}" Width="11" Height="11" Stretch="Uniform" Fill="{StaticResource Jer.Text2}"/>
                                    <Border CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Music.Media.Artwork}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid x:Name="MiniRing" Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse Stroke="{StaticResource Jer.Fill2}" StrokeThickness="2.5"/>
                                <Ellipse Stroke="{Binding Pomodoro.ModeBrush}" StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5"
                                         StrokeDashArray="{Binding Pomodoro.Progress, Converter={StaticResource ProgressToDash}, ConverterParameter='16,2.5'}">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>

                            <TextBlock x:Name="ClockText" Grid.Column="1" Style="{StaticResource CollapsedClock}"
                                       FontFamily="{StaticResource Jer.DisplayFont}" FontSize="13.5" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel x:Name="EqBars" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding Music.Media.Accent, Converter={StaticResource ColorToBrush}}"/>
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding Music.Media.Accent, Converter={StaticResource ColorToBrush}}"/>
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding Music.Media.Accent, Converter={StaticResource ColorToBrush}}"/>
                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding Music.Media.Accent, Converter={StaticResource ColorToBrush}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ Mascot ============ -->
                        <Grid x:Name="MascotView" Height="32" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="EyesShift"/>
                                </Grid.RenderTransform>
                                <StackPanel x:Name="OpenEyes" Orientation="Horizontal">
                                    <Border x:Name="LeftEye" Width="9" Height="14" CornerRadius="4.5" Background="White" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="LeftEyeScale"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="RightEye" Width="9" Height="14" CornerRadius="4.5" Background="White" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="RightEyeScale"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="HappyEyes" Orientation="Horizontal" Visibility="Collapsed">
                                    <Path Width="11" Height="7" Stretch="Fill" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0,6 Q5.5,-2 11,6" Margin="0,0,12,0"/>
                                    <Path Width="11" Height="7" Stretch="Fill" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M0,6 Q5.5,-2 11,6"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SleepyZ" Text="z" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Jer.Text2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="52,0,0,10" Opacity="0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="SleepyZShift"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <!-- ============ Open ============ -->
                        <Grid x:Name="ExpandedView" Width="560" Height="206" VerticalAlignment="Top" HorizontalAlignment="Center"
                              Visibility="Collapsed" Opacity="0" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="22,4,22,0">
                                <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{StaticResource Jer.Text2}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ToastText}" FontSize="12" Foreground="{StaticResource Jer.Text}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Pages -->
                            <Grid x:Name="PagesHost" Grid.Row="1" Margin="20,2,20,0">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="PageShift"/>
                                </Grid.RenderTransform>

                                <!-- Music -->
                                <Grid x:Name="MusicPage" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Music}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding Music.Media.HasSession, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <Path Data="{StaticResource Icon.Music}" Width="30" Height="30" Stretch="Uniform" Fill="{StaticResource Jer.Text3}"/>
                                        <TextBlock Text="Nothing playing" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock Text="Play something in Spotify, YouTube or any music app." FontSize="12"
                                                   Foreground="{StaticResource Jer.Text3}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Grid Visibility="{Binding Music.Media.HasSession, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="112" Height="112" CornerRadius="16" Background="{StaticResource Jer.Fill3}" VerticalAlignment="Center">
                                            <Grid>
                                                <Path Data="{StaticResource Icon.Music}" Width="34" Height="34" Stretch="Uniform" Fill="{StaticResource Jer.Text3}"/>
                                                <Border CornerRadius="16">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Music.Media.Artwork}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Music.Media.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <DockPanel Grid.Row="1" Margin="0,1,0,0" LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Music.Media.SourceName}" FontSize="11" Foreground="{StaticResource Jer.Text3}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Music.Media.Artist}" FontSize="12.5" Foreground="{StaticResource Jer.Text2}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <Slider x:Name="ProgressSlider" Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource Jer.Slider}"
                                                    Minimum="0" Maximum="1" LargeChange="0.05" SmallChange="0.01"
                                                    Value="{Binding Music.Progress, Mode=OneWay}"
                                                    IsEnabled="{Binding Music.Media.CanSeek}"
                                                    Foreground="{Binding Music.Media.Accent, Converter={StaticResource ColorToBrush}}"/>
                                            <Grid Grid.Row="3" Margin="0,0,0,0">
                                                <TextBlock Text="{Binding Music.ElapsedText}" FontSize="10.5" Foreground="{StaticResource Jer.Text3}" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Text="{Binding Music.RemainingText}" FontSize="10.5" Foreground="{StaticResource Jer.Text3}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Grid.Row="4" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="104"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource LyricsToggleButton}" HorizontalAlignment="Left"
                                                        Width="32" Height="32" Padding="8" Command="{Binding Music.ToggleLyricsCommand}" ToolTip="Lyrics"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Previous}" Width="36" Height="36" Padding="10"
                                                            Command="{Binding Music.PreviousCommand}" IsEnabled="{Binding Music.Media.CanPrevious}"/>
                                                    <Button Style="{StaticResource PlayPauseButton}" Width="42" Height="42" Padding="10" Margin="4,0"
                                                            Command="{Binding Music.PlayPauseCommand}"/>
                                                    <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Next}" Width="36" Height="36" Padding="10"
                                                            Command="{Binding Music.NextCommand}" IsEnabled="{Binding Music.Media.CanNext}"/>
                                                </StackPanel>
                                                <StackPanel x:Name="VolumeHost" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent"
                                                            Visibility="{Binding Music.HasVolume, Converter={StaticResource BoolToVisibility}}">
                                                    <Slider x:Name="VolumeSlider" Width="0" Style="{StaticResource Jer.Slider}" Minimum="0" Maximum="100" LargeChange="5"
                                                            Value="{Binding Music.Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,2,0" Opacity="0"/>
                                                    <Button Style="{StaticResource SpeakerButton}" Width="32" Height="32" Padding="8" Command="{Binding Music.ToggleMuteCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- Lyrics, split next to the player -->
                                        <Grid x:Name="LyricsPanel" Grid.Column="2" Width="252" Margin="20,0,0,0"
                                              Visibility="{Binding Music.LyricsEnabled, Converter={StaticResource BoolToVisibility}}">
                                            <ScrollViewer x:Name="LyricsScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                          Focusable="False">
                                                <ScrollViewer.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="Black" Offset="0.2"/>
                                                        <GradientStop Color="Black" Offset="0.8"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </ScrollViewer.OpacityMask>
                                                <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Music.Lines}" Margin="0,50">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.Music.SeekToLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Cursor="Hand" Focusable="False" HorizontalContentAlignment="Left">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="Transparent" Padding="0,3">
                                                                            <ContentPresenter/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Jer.Text2}"/>
                                                            </Button>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Jer.Text3}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter TargetName="Line" Property="Foreground" Value="White"/>
                                                                    <Setter TargetName="Line" Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter TargetName="Line" Property="FontSize" Value="14.5"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Text="{Binding Music.LyricsMessage}" FontSize="12" Foreground="{StaticResource Jer.Text3}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- Pomodoro -->
                                <Grid x:Name="PomodoroPage" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Pomodoro}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="116" Height="116" VerticalAlignment="Center">
                                        <Ellipse Stroke="{StaticResource Jer.Fill2}" StrokeThickness="7"/>
                                        <Ellipse Stroke="{Binding Pomodoro.ModeBrush}" StrokeThickness="7" RenderTransformOrigin="0.5,0.5"
                                                 StrokeDashArray="{Binding Pomodoro.Progress, Converter={StaticResource ProgressToDash}, ConverterParameter='116,7'}">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Pomodoro.RemainingText}" FontFamily="{StaticResource Jer.DisplayFont}" FontSize="26" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Pomodoro.ModeShort}" FontSize="11" Foreground="{StaticResource Jer.Text3}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Pomodoro.ModeTitle}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Pomodoro.SessionText}" FontSize="12" Foreground="{StaticResource Jer.Text2}" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Style="{StaticResource Jer.PillButton}" Background="{Binding Pomodoro.ModeBrush}" Foreground="Black" MinWidth="92"
                                                    Command="{Binding Pomodoro.StartPauseCommand}">
                                                <TextBlock Text="{Binding Pomodoro.StartLabel}"/>
                                            </Button>
                                            <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Reset}" Width="30" Height="30" Padding="7" Margin="8,0,0,0"
                                                    Command="{Binding Pomodoro.ResetCommand}" ToolTip="Reset"/>
                                            <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Next}" Width="30" Height="30" Padding="8" Margin="2,0,0,0"
                                                    Command="{Binding Pomodoro.SkipCommand}" ToolTip="Skip"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Pomodoro.NextText}" FontSize="11" Foreground="{StaticResource Jer.Text3}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Water -->
                                <Grid x:Name="WaterPage" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Water}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="116" Height="116" VerticalAlignment="Center">
                                        <Ellipse Stroke="{StaticResource Jer.Fill2}" StrokeThickness="7"/>
                                        <Ellipse Stroke="{StaticResource Jer.Water}" StrokeThickness="7" RenderTransformOrigin="0.5,0.5"
                                                 StrokeDashArray="{Binding Water.Progress, Converter={StaticResource ProgressToDash}, ConverterParameter='116,7'}">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Water}" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource Jer.Water}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Water.AmountText}" FontFamily="{StaticResource Jer.DisplayFont}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Water.GoalText}" FontSize="11" Foreground="{StaticResource Jer.Text3}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Width="150">
                                        <TextBlock Text="Water" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Water.StatusText}" FontSize="12" Foreground="{StaticResource Jer.Text2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Water.LastDrinkText}" FontSize="11" Foreground="{StaticResource Jer.Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource Jer.PillButton}" Background="{StaticResource Jer.Water}" Foreground="Black"
                                                    Command="{Binding Water.DrinkCommand}" Padding="12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Plus}" Width="10" Height="10" Stretch="Uniform" Fill="Black" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Water.DrinkLabel}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Jer.TextButton}" Content="Undo" Margin="4,0,0,0" Command="{Binding Water.UndoCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="2" Margin="18,6,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="16"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Water.ChartMaxText}" FontSize="9.5" Foreground="{StaticResource Jer.Text3}" HorizontalAlignment="Right"/>
                                        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Jer.Divider}">
                                            <ItemsControl ItemsSource="{Binding Water.Bars}" VerticalAlignment="Bottom" Height="86">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Bar" VerticalAlignment="Bottom" CornerRadius="2.5,2.5,0,0" Margin="1.5,0" MinHeight="2"
                                                                Height="{Binding Height, Converter={StaticResource Multiply}, ConverterParameter=84}"
                                                                Background="{StaticResource Jer.Water}" Opacity="0.55"/>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Water.Bars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{StaticResource Jer.Text3}" HorizontalAlignment="Center" Margin="-8,2,-8,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>

                                <!-- Shelf -->
                                <Grid x:Name="ShelfPage" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Shelf}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Jer.TextButton}" Content="Clear" Command="{Binding Shelf.ClearCommand}"
                                                Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Shelf" Style="{StaticResource PageHeader}"/>
                                            <TextBlock Text="{Binding Shelf.CountText}" FontSize="11.5" Foreground="{StaticResource Jer.Text3}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ctrl+click to select several" FontSize="11" Foreground="{StaticResource Jer.Text3}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,4,0,4">
                                        <Grid Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                            <Rectangle Stroke="{StaticResource Jer.Fill2}" StrokeThickness="1.5" StrokeDashArray="5,4" RadiusX="14" RadiusY="14"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Drop}" Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Jer.Text3}"/>
                                                <TextBlock Text="Drop files here" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                <TextBlock Text="Drag out anytime · click to open" FontSize="11.5" Foreground="{StaticResource Jer.Text3}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <ScrollViewer x:Name="ShelfScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                                      Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <ItemsControl ItemsSource="{Binding Shelf.Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Tile" Width="94" Height="110" CornerRadius="12" Margin="0,0,8,0" Background="{StaticResource Jer.Fill3}"
                                                                BorderThickness="1.5" BorderBrush="Transparent" Cursor="Hand"
                                                                PreviewMouseLeftButtonDown="ShelfTile_PreviewMouseLeftButtonDown"
                                                                PreviewMouseMove="ShelfTile_PreviewMouseMove"
                                                                PreviewMouseLeftButtonUp="ShelfTile_PreviewMouseLeftButtonUp">
                                                            <Grid>
                                                                <StackPanel Margin="8,10,8,6">
                                                                    <Grid Width="54" Height="54">
                                                                        <Path Data="{Binding Icon}" Width="34" Height="34" Stretch="Uniform" Fill="{StaticResource Jer.Text2}"/>
                                                                        <Border CornerRadius="10">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform"/>
                                                                            </Border.Background>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,6,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Jer.Text3}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <Button x:Name="RemoveButton" Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Close}"
                                                                        Width="20" Height="20" Padding="5" Margin="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                        Background="#99000000" Visibility="Hidden"
                                                                        Command="{Binding DataContext.Shelf.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource Jer.Fill1}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Jer.Accent}"/>
                                                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource Jer.AccentSoft}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Border x:Name="DropOverlay" CornerRadius="14" Background="#E6000000" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                            <Grid>
                                                <Rectangle Stroke="{StaticResource Jer.Accent}" StrokeThickness="2" StrokeDashArray="5,4" RadiusX="14" RadiusY="14"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.Drop}" Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource Jer.Accent}"/>
                                                    <TextBlock Text="Release to add" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- To-do -->
                                <Grid x:Name="TodoPage" Visibility="{Binding SelectedPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Todo}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Jer.TextButton}" Content="Clear done" Command="{Binding Todo.ClearDoneCommand}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Todo.SummaryText}" FontSize="11.5" Foreground="{StaticResource Jer.Text2}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="To-do" Style="{StaticResource PageHeader}"/>
                                            <TextBlock Text="{Binding Todo.InputError}" FontSize="11.5" Foreground="{StaticResource Jer.Red}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Grid.Row="1">
                                        <TextBlock Text="No tasks yet. Add one below, with a time if you'd like a reminder." FontSize="12" Foreground="{StaticResource Jer.Text3}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Todo.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding Todo.Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Row" Height="27" CornerRadius="8" Background="Transparent" Padding="6,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Style="{StaticResource Jer.TaskCheck}" Tag="{Binding ColorBrush}" IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="TaskTitle" Grid.Column="1" Text="{Binding Title}" FontSize="13" Margin="10,0,8,0"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Border x:Name="DuePill" Grid.Column="2" CornerRadius="8" Background="{StaticResource Jer.Fill1}" Padding="7,1" VerticalAlignment="Center"
                                                                        Visibility="{Binding DueText, Converter={StaticResource NullToVisibility}}">
                                                                    <TextBlock x:Name="DueLabel" Text="{Binding DueText}" FontSize="10.5" Foreground="{StaticResource Jer.Text2}"/>
                                                                </Border>
                                                                <StackPanel x:Name="RowActions" Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0" Visibility="Hidden">
                                                                    <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Edit}" Width="24" Height="24" Padding="6"
                                                                            Foreground="{StaticResource Jer.Text2}"
                                                                            Command="{Binding DataContext.Todo.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                    <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Trash}" Width="24" Height="24" Padding="6"
                                                                            Foreground="{StaticResource Jer.Text2}"
                                                                            Command="{Binding DataContext.Todo.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Jer.Fill3}"/>
                                                                <Setter TargetName="RowActions" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter TargetName="TaskTitle" Property="Foreground" Value="{StaticResource Jer.Text3}"/>
                                                                <Setter TargetName="TaskTitle" Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter TargetName="DueLabel" Property="Foreground" Value="{StaticResource Jer.Red}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,4,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Width="30" Height="30" Cursor="Hand" Focusable="False" Command="{Binding Todo.NextColorCommand}" ToolTip="Task colour">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{StaticResource Jer.Fill3}" CornerRadius="10">
                                                        <Ellipse Width="12" Height="12" Fill="{Binding Todo.NewColorBrush}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBox x:Name="TodoTitleBox" Grid.Column="1" Style="{StaticResource Jer.TextBox}" Margin="6,0,0,0" Tag="Add a task…"
                                                 Text="{Binding Todo.NewTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="140"
                                                 PreviewMouseLeftButtonDown="TextInput_PreviewMouseLeftButtonDown">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding Todo.SubmitCommand}"/>
                                                <KeyBinding Key="Escape" Command="{Binding Todo.CancelEditCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBox x:Name="TodoTimeBox" Grid.Column="2" Style="{StaticResource Jer.TextBox}" Width="66" Margin="6,0,0,0" Tag="Time"
                                                 Text="{Binding Todo.NewTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                                                 PreviewMouseLeftButtonDown="TextInput_PreviewMouseLeftButtonDown" ToolTip="Optional reminder time, e.g. 15:30">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding Todo.SubmitCommand}"/>
                                                <KeyBinding Key="Escape" Command="{Binding Todo.CancelEditCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="3" Style="{StaticResource Jer.PillButton}" Background="{StaticResource Jer.Accent}" Foreground="Black" Margin="6,0,0,0"
                                                Command="{Binding Todo.SubmitCommand}" MinWidth="58">
                                            <TextBlock Text="{Binding Todo.SubmitLabel}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Page bar: dots that turn into icons (plus Settings) when hovered -->
                            <Grid x:Name="PageBar" Grid.Row="2" Width="260" HorizontalAlignment="Center" Background="Transparent"
                                  MouseEnter="PageBar_MouseEnter" MouseLeave="PageBar_MouseLeave">
                                <ItemsControl x:Name="PageDots" ItemsSource="{Binding Pages}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Dot" Width="6" Height="6" CornerRadius="3" Margin="3,0" Background="{StaticResource Jer.Text3}"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Dot" Property="Width" Value="16"/>
                                                    <Setter TargetName="Dot" Property="Background" Value="White"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel x:Name="PageIcons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Opacity="0" IsHitTestVisible="False">
                                    <ItemsControl ItemsSource="{Binding Pages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button x:Name="PageButton" Style="{StaticResource Jer.IconButton}" Tag="{Binding Icon}" Width="26" Height="26" Padding="6.5" Margin="1,0"
                                                        Foreground="{StaticResource Jer.Text3}" ToolTip="{Binding Title}"
                                                        Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="PageButton" Property="Foreground" Value="White"/>
                                                        <Setter TargetName="PageButton" Property="Background" Value="{StaticResource Jer.Fill1}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Width="1" Height="14" Background="{StaticResource Jer.Divider}" Margin="6,0"/>
                                    <Button Style="{StaticResource Jer.IconButton}" Tag="{StaticResource Icon.Settings}" Width="26" Height="26" Padding="6.5"
                                            Foreground="{StaticResource Jer.Text3}" ToolTip="Settings" Click="SettingsButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ============ Overlay (volume, Caps Lock, charging...) ============ -->
                        <Grid x:Name="HudView" Width="330" Height="42" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{Binding Icon}" Fill="{Binding Accent}" Width="17" Height="17" Stretch="Uniform" Margin="20,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel x:Name="HudRight" Grid.Column="2" Orientation="Horizontal" Margin="10,0,20,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HudDetail" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Jer.Text2}" VerticalAlignment="Center"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                <Grid x:Name="HudBar" Width="104" Height="4" VerticalAlignment="Center">
                                    <Border CornerRadius="2" Background="{StaticResource Jer.Fill2}"/>
                                    <Border x:Name="HudBarFill" CornerRadius="2" Background="{Binding Accent}" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="HudLevel" FontSize="12" FontWeight="SemiBold" Width="28" TextAlignment="Right" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Grid>

                        <!-- ============ Alert (reminders, timers) ============ -->
                        <Grid x:Name="AlertView" Width="460" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0">
                            <Grid Margin="20,12,20,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,14,0">
                                    <Ellipse Fill="{Binding Accent}" Opacity="0.2"/>
                                    <Path Data="{Binding Icon}" Fill="{Binding Accent}" Width="19" Height="19" Stretch="Uniform"/>
                                </Grid>
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Message}" FontSize="12.5" Foreground="{StaticResource Jer.Text2}" TextWrapping="Wrap" MaxHeight="36"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>
                                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Actions}" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="ActionButton" Style="{StaticResource Jer.PillButton}" Margin="8,0,0,0" MinWidth="72" Command="{Binding Command}">
                                                <TextBlock Text="{Binding Label}"/>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter TargetName="ActionButton" Property="Background"
                                                            Value="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                    <Setter TargetName="ActionButton" Property="Foreground" Value="Black"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Path x:Name="RightShoulder" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Top"
                      Fill="Black" Data="M0,0 H10 A10,10 0 0 0 0,10 Z"/>
            </Grid>

            <!-- Lyrics pill under the closed notch -->
            <Border x:Name="LyricPill" Background="Black" CornerRadius="15" Height="30" Margin="0,6,0,0" Width="180"
                    HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="14,0">
                    <Path Data="{StaticResource Icon.Music}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                          Fill="{Binding Music.Media.Accent, Converter={StaticResource ColorToBrush}}"/>
                    <TextBlock x:Name="LyricText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
